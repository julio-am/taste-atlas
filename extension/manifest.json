{
  "manifest_version": 3,
  "name": "TasteMate Capture",
  "version": "0.4.0",
  "description": "Capture a page, image area, or text selection and save annotated references to your local TasteMate profile.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save to TasteMate",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Capture in TasteMate"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src 'none'; object-src 'none'; base-uri 'none'"
  }
}
